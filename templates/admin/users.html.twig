{% extends 'base.html.twig' %}

{% block title %}Utilisateurs
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('style') }}
{% endblock %}

{% block body %}
	<div
		class="dashboard-container">

		<!-- Hamburger -->
		<button id="hamburgerButton" class="hamburger">☰</button>

		{# Sidebar #}
		{% include 'includes/admin/administrator_sidebar.html.twig' %}

		<!-- Main -->
		<main class="dashboard-main">
			<h1 class="mb-4">Gestion des utilisateurs</h1>

			<a href="{{ path('admin_user_add') }}" class="btn btn-success mb-4">➕ Ajouter un utilisateur</a>

            <input type="text" id="userSearch" class="form-control-administrator mb-3" placeholder="🔍 Rechercher par utilisateur, nom, prénom ou email">

			<div class="table-responsive"></br>
			<table class="table table-bordered table-striped">
				<thead class="table-light">
					<tr>
						<th>ID</th>
						<th>Nom d'utilisateur</th>
                        <th>Prénom</th>
                        <th>Nom</th>
						<th>Email</th>
						<th>Rôles</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						<tr>
							<td>{{ user.id }}</td>
							<td>{{ user.username }}</td>
                            <td>{{ user.firstname }}</td>
                            <td>{{ user.lastname }}</td>
							<td>{{ user.email }}</td>
							<td>{{ user.roles|join(', ') }}</td>
							<td>
								<div class="action-buttons">
									<a href="{{ path('admin_user_edit', { id: user.id }) }}" class="btn-edit-administrator btn-sm btn-primary">Modifier</a>

									<form method="post" action="{{ path('admin_user_delete', { id: user.id }) }}" onsubmit="return confirm('Confirmer la suppression ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
										<button class="btn btn-sm btn-danger" type="submit">Supprimer</button>
									</form>
								</div>
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="5" class="text-center">Aucun utilisateur trouvé.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</main>
</div>{% endblock %}
