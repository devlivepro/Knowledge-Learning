{% extends 'base.html.twig' %}

{% block title %}Mon profil
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('style') }}
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		{# Button hamburger #}
		<button id="hamburgerButton" class="hamburger">☰</button>

		{# Sidebar #}
		{% include 'includes/admin/admin_sidebar.twig' %}

		<main class="dashboard-main">

			{% for message in app.flashes('profile_success') %}
				<div class="alert alert-success">
					{{ message }}
				</div>
			{% endfor %}

			{# Error message display #}
			{% for message in app.flashes('error') %}
				<div class="alert alert-danger">
					{{ message }}
				</div>
			{% endfor %}

			<h1 class="mb-4">Mon profil</h1>

			<div class="card p-4 shadow-sm" style="max-width: 600px;">
				<h5 class="text-primary border-bottom pb-2 mb-4">Informations personnelles</h5>

				<div class="mb-3">
					<label class="form-label fw-bold">
						Nom d'utilisateur :
						<span class="text-muted fst-italic" style="font-size: 0.9em;">(non modifiable)</span>
					</label>
					<div class="form-control bg-light">{{ app.user.username }}</div>
				</div>

				{{ form_start(form) }}
				{{ form_errors(form) }}


				<div class="mb-3">
					{{ form_label(form.firstName) }}
					{{ form_widget(form.firstName, { 'attr': { 'class': 'form-control' } }) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.lastName) }}
					{{ form_widget(form.lastName, { 'attr': { 'class': 'form-control' } }) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.phone) }}
					{{ form_widget(form.phone, {'attr': {'class': 'form-control','inputmode': 'numeric','pattern': '[0-9]*','oninput': "this.value = this.value.replace(/[^0-9]/g, '')"}}) }}
					{{ form_errors(form.phone) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.address) }}
					{{ form_widget(form.address, { 'attr': { 'class': 'form-control' } }) }}
				</div>

				<h5 class="text-primary border-bottom pb-2 mt-4 mb-4">Sécurité</h5>

				<div class="mb-3">
					{{ form_label(form.email) }}
					{{ form_widget(form.email, { 'attr': { 'class': 'form-control' } }) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.plainPassword.first) }}
					{{ form_widget(form.plainPassword.first, { 'attr': { 'class': 'form-control' } }) }}
					{{ form_errors(form.plainPassword.first) }}
				</div>

				<div class="mb-3">
					{{ form_label(form.plainPassword.second) }}
					{{ form_widget(form.plainPassword.second, { 'attr': { 'class': 'form-control' } }) }}
					{{ form_errors(form.plainPassword.second) }}
				</div>

				<button type="submit" class="btn btn-success w-100 mt-3">💾 Sauvegarder</button>
				{{ form_widget(form.username, { attr: { style: 'display:none;' } }) }}
				{{ form_end(form) }}
			</div>
		</main>
	</div>
{% endblock %}
