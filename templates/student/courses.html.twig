{% extends 'base.html.twig' %}

{% block title %}Mes Formations
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{{ encore_entry_link_tags('style') }}
{% endblock %}

{% block body %}
	<div class="dashboard-container">

		{# Button hamburger #}
		<button id="hamburgerButton" class="hamburger">☰</button>

		{# Sidebar #}
		{% include 'includes/admin/admin_sidebar.html.twig' %}

		<main class="dashboard-main">
			<h1 class="text-center mb-4">Mes Formations</h1>

			{% if orders is not empty %}
				<div class="results-row">

					{% for order in orders %}
						{% if order.cursus %}
							{# Case of a complete package (curriculum) #}
							{% set cursus = order.cursus %}
							{% set totalLessons = cursus.lessons|length %}
							{% set pct = progress[cursus.id]|default(0) %}
							{% set validatedCount = (pct * totalLessons / 100)|round(0, 'floor') %}

							<div class="card shadow-sm courses-card text-center">
								<div class="card-body d-flex flex-column">
									<h5 class="card-title">{{ cursus.title }}</h5>
									<p class="card-text">Acheté le
										{{ order.createdAt|date('d/m/Y') }}</p>

									<div class="mb-4 text-center">
										<div class="progress" style="height: 50px;">
											<div class="progress-bar bg-success" role="progressbar" style="width: {{ pct }}%;" aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100">
												{{ pct }}%
											</div>
										</div>
									</div>

									<a href="{{ path('cursus_suivi', {'id': cursus.id}) }}" class="btn btn-primary mt-3">Accéder au suivi</a>

								</div>
							</div>

						{% elseif order.lesson %}
							{# Individual lesson #}
							{% set lesson = order.lesson %}
							<div class="card shadow-sm courses-card text-center">
								<div class="card-body d-flex flex-column">
									<h5 class="card-title">{{ lesson.title }}</h5>
									<p class="card-text">Achetée le
										{{ order.createdAt|date('d/m/Y') }}</p>

									<div class="text-muted mb-3">Leçon achetée individuellement</div>
								</br>

								<a href="{{ path('student_lesson', { 'id': lesson.id }) }}" class="btn btn-primary btn-sm">Accéder au suivi</a>

							</div>
						</div>
					{% endif %}
				{% endfor %}

			</div>
		{% else %}
			<div class="text-center">
				<p>Vous n'avez encore acheté aucune formation.</p>
			</div>
		{% endif %}
	</main>
</div>{% endblock %}
