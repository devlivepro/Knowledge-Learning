{% extends 'base.html.twig' %}

{% block title %}Accueil - Formations{% endblock %}

{% block body %}
<div class="container mt-5">
    <h1 class="text-center mb-5">Bienvenue sur Knowledge Learning 🎓</h1>

    <div class="row">
        {% for theme in themes %}
            <div class="col-md-6 mb-4">
                <div class="card shadow">
                    <div class="card-body text-center">
                        <h2>{{ theme.title }}</h2>
                        <a href="{{ path('theme_show', {'id': theme.id}) }}" class="btn btn-primary mt-3">
                            Voir les cursus
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}