{% extends 'base.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block body %}
	<!-- Inclusion of header -->
	{% include 'includes/header.html.twig' %}

	<section class="heading">
		<p class="heading_title_description">
			Avec
			<strong>Knowledge</strong>, formez-vous librement et donnez vie à vos ambitions.
		</p>
		<a href="{{ path('app_register') }}" class="btn_go">
			<i class="fas fa-star"></i>
			Je me forme dès maintenant
		</a>
	</section>

	<section class="why-choose-us">
		<h1 class="section-title text-center">Pourquoi choisir Knowledge&nbsp;?</h1>
		<div class="card-container">
			<div class="card">
				<h3>
					<i class="fas fa-chalkboard-teacher"></i>
					Contenus pédagogiques d'exception</h3>
				<p>Apprenez avec des cours soigneusement conçus par des experts passionnés, pour garantir votre réussite.</p>
			</div>
			<div class="card">
				<h3>
					<i class="fas fa-infinity"></i>
					Accès illimité à votre formation</h3>
				<p>Vos cours vous appartiennent à vie : progressez à votre rythme, sans contrainte de temps ni d'expiration.</p>
			</div>
			<div class="card">
				<h3>
					<i class="fas fa-clock"></i>
					Une flexibilité pensée pour vous</h3>
				<p>Formez-vous où vous voulez, quand vous voulez, et adaptez votre apprentissage à votre emploi du temps.</p>
			</div>
		</div>
	</section>

	<section class="formation">
		<p>
			<strong>Développez vos compétences</strong>
			dans les domaines qui vous passionnent</p>

		<div class="card2-container">
			{% for theme in themes %}
				<div class="card2">
					<img src="{{ asset('img/' ~ theme.image) }}" alt="{{ theme.title }}"/>
					<h3 class="{{ theme.title|lower|replace({' ': '-'}) }}-title">
						<i class="fas {{ theme.icon }}"></i>
						{{ theme.title }}
					</h3>
					<p>{{ theme.text }}</p>
					<a href="{{ path('visitor_themes_filter', { 'filter': theme.id }) }}" class="btn-custom">Je Découvre</a>
				</div>
			{% endfor %}
		</div>
	</section>

	<!-- Footer inclusion -->
	{% include 'includes/footer.html.twig' %}

{% endblock %}
